# ===============================
# Project
# ===============================
ENV=dev
PROJECT_HOST="127.0.0.1"
PROJECT_PORT=8000
ENABLE_LANGSERVE_EXTRAS=true
ENABLE_LANGGRAPH=false
ENABLE_QUERY_REWRITE=true
ENABLE_RERANK=false
LANGGRAPH_CHECKPOINTER=postgres
ENABLE_OBS_LOGS=true
ENABLE_MULTI_RAG=false
ENABLE_TOOL_AGENT=false

# ===============================
# Logging
# ===============================
LOG_LEVEL="DEBUG"

# ===============================
# Qwen
# ===============================
QWEN_API_KEY="your-key"

# ===============================
# PostgreSQL
# ===============================
PG_USER=postgres
PG_PASSWORD=your_dev_password
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DB=ai_engine_dev

# ===============================
# DB Pool
# ===============================
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=True

# ===============================
# Knowledge Base
# ===============================
# KB_INIT_MODE: skip | incremental | overwrite
KB_INIT_MODE=incremental
