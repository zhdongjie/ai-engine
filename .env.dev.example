# ===============================
# 项目配置
# ===============================
PROJECT_RELOAD=true
PROJECT_HOST="127.0.0.1"
PROJECT_PORT=8000
ENABLE_LANGSERVE_EXTRAS=true

# ===============================
# 日志配置
# ===============================
LOG_LEVEL="DEBUG"

# ===============================
# Qwen配置
# ===============================
QWEN_API_KEY="sk-你的key"

# ===============================
# Rerank配置
# ===============================
# (沿用 .env 基础配置)

# ===============================
# Chroma配置
# ===============================
# (沿用 .env 基础配置)

# ===============================
# Prompts配置
# ===============================
# (沿用 .env 基础配置)

# ===============================
# Knowledge配置
# ===============================
# (沿用 .env 基础配置)

# ===============================
# PostgreSQL 数据库配置
# ===============================
PG_USER=postgres
PG_PASSWORD=your_dev_password
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DB=ai_engine_dev

# ===============================
# 数据库连接池调优
# ===============================
# 开发期调小连接池，开启 SQL 打印方便排错
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=True

# ===============================
# 向量数据库引擎选择
# ===============================
# 开发期每次启动检查并初始化知识库
INIT_KNOWLEDGE_BASE=true

# ===============================
# RAG 高级策略开关
# ===============================
ENABLE_QUERY_TRANSFORM=true
QUERY_TRANSFORM_MAX_QUERIES=3
ENABLE_LEXICAL_RETRIEVAL=true
LEXICAL_SEARCH_TOP_K=8
RRF_K=60
ENABLE_CONTEXT_ENRICHMENT=true
CONTEXT_WINDOW_SIZE=1