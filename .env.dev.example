# ===============================
# 项目配置
# ===============================
ENV=dev
PROJECT_RELOAD=true
PROJECT_HOST="127.0.0.1"
PROJECT_PORT=8000
ENABLE_LANGSERVE_EXTRAS=true

# ===============================
# 日志配置
# ===============================
LOG_LEVEL="DEBUG"

# ===============================
# Qwen配置
# ===============================
QWEN_API_KEY="sk-你的key"

# ===============================
# Rerank配置
# ===============================
# (沿用 .env 基础配置)

# ===============================
# Chroma配置
# ===============================
# (沿用 .env 基础配置)

# ===============================
# Prompts配置
# ===============================
# (沿用 .env 基础配置)

# ===============================
# Knowledge配置
# ===============================
# (沿用 .env 基础配置)

# ===============================
# PostgreSQL 数据库配置
# ===============================
PG_USER=postgres
PG_PASSWORD=your_dev_password
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DB=ai_engine_dev

# ===============================
# 数据库连接池调优
# ===============================
# 开发期调小连接池，开启 SQL 打印方便排错
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=True

# 开发期每次启动检查并初始化知识库
INIT_KNOWLEDGE_BASE=true

# ===============================
# 知识库引擎配置 (Knowledge Base)
# ===============================
# 知识库初始化模式 (KB_INIT_MODE):
#   - skip: 不做任何处理，直接跳过 (适合正常重启)
#   - incremental: 增量模式，只对比并处理被修改或新增的文件 (适合开发和日常维护)
#   - overwrite: 全量覆盖模式，清空向量库和追踪记录，从头全部 Rebuild (适合重大策略调整)
KB_INIT_MODE=incremental