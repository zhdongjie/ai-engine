# ===============================
# 项目配置
# ===============================
PROJECT_NAME="AI-Engine"
PROJECT_DESCRIPTION="基于 LangServe 与 RAG 架构的底层能力支撑 API。\n\n包含核心对话流、记忆管理以及系统监控能力。"
PROJECT_VERSION="0.1.0"
MAX_HISTORY_MESSAGES=20

# ===============================
# 日志配置
# ===============================
LOG_DIR="logs"

# ===============================
# Qwen配置
# ===============================
QWEN_API_BASE="https://dashscope.aliyuncs.com/compatible-mode/v1"
QWEN_MODEL_LLM="qwen-plus"
QWEN_MODEL_EMBEDDING="text-embedding-v3"
QWEN_EMBEDDING_DIM=1024
TEMPERATURE=0

# ===============================
# Rerank配置
# ===============================
QWEN_MODEL_RERANK=gte-rerank-v2
RERANK_THRESHOLD=0.4
RERANK_TOP_N=3
VECTOR_SEARCH_TOP_K=12

# ===============================
# RAG Retrieval Strategy
# ===============================
ENABLE_QUERY_TRANSFORM=true
QUERY_TRANSFORM_MAX_QUERIES=3
ENABLE_LEXICAL_RETRIEVAL=true
LEXICAL_SEARCH_TOP_K=8
RRF_K=60
ENABLE_CONTEXT_ENRICHMENT=true
CONTEXT_WINDOW_SIZE=1

# ===============================
# RAG Quality And Compression
# ===============================
ENABLE_RETRIEVAL_QUALITY_CHECK=true
MIN_RETRIEVAL_DOCS=2
MIN_RETRIEVAL_SOURCES=1
MIN_RERANK_SCORE=0.2
MIN_RERANK_SCORE_GAP=0.02
ENABLE_CONTEXT_COMPRESSION=true
MAX_CONTEXT_CHUNKS=6
MAX_CONTEXT_CHARACTERS=6000

# ===============================
# Chroma配置
# ===============================
CHROMA_DATA_DIR="data/chroma_data"

# ===============================
# Prompts配置
# ===============================
PROMPTS_DATA_DIR="resource/prompts"

# ===============================
# Knowledge配置
# ===============================
KNOWLEDGE_DATA_DIR="resource/knowledge"

# ===============================
# PostgreSQL 数据库配置
# ===============================
# (通用配置留空，由 dev/prod 文件覆盖注入)

# ===============================
# 数据库连接池调优
# ===============================
# (通用配置留空，由 dev/prod 文件覆盖注入)

# ===============================
# 向量数据库引擎选择
# ===============================
VECTOR_STORE_TYPE=postgresql
